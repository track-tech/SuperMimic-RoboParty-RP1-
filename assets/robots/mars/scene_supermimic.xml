<mujoco model="mars_supermimic_scene">
  <compiler angle="radian" meshdir="./"/>
  <option timestep="0.0025" gravity="0 0 -9.81" solver="CG" iterations="50"/>
  <visual>
    <global offwidth="1280" offheight="720"/>
    <quality offsamples="4"/>
    <headlight ambient="0.35 0.35 0.35" diffuse="0.55 0.55 0.55"/>
  </visual>
  <worldbody>
    <geom name="floor" type="plane" size="40 40 0.1" friction="1 0.005 0.0001"
          condim="3" material="groundplane"/>
  </worldbody>
  <asset>
    <texture name="groundplane" type="2d" builtin="checker" mark="edge"
             rgb1="0.22 0.24 0.27" rgb2="0.30 0.32 0.35" markrgb="0.9 0.9 0.9"
             width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>
  </asset>
  <include file="mars_supermimic.xml"/>
</mujoco>
